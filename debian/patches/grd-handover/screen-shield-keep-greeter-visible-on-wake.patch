         this._grab = null;
-        this._isGreeter = false;
+        // 无显示器时，空闲与唤醒可能早于 showDialog()，不能先按用户会话处理。
+        this._isGreeter = Main.sessionMode.isGreeter;
         this._isActive = false;
         this._isLocked = false;
         this._inUnlockAnimation = false;
@@ -565,7 +566,9 @@
