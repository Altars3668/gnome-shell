+        this._shortLightbox.lightOff();

         if (Main.sessionMode.currentMode === 'unlock-dialog')
             Main.sessionMode.popMode('unlock-dialog');
@@ -585,7 +588,9 @@
             return;
         }

-        if (this._dialog && !this._isGreeter)
+        this._hideLockScreen(animate);
+
+        if (this._dialog)
             this._dialog.popModal();

         if (this._grab) {
